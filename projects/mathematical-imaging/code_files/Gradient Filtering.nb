Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"input", " ", "=", 
    RowBox[{
    "Import", "[", 
     "\"\</Users/zhangjianing/Desktop/Spring 2023/math 155/cascades.jpeg\>\"",
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", " ", "=", " ", 
    RowBox[{"ImageResize", "[", 
     RowBox[{
      RowBox[{"ColorConvert", "[", 
       RowBox[{"input", ",", " ", "\"\<Grayscale\>\""}], "]"}], ",", "300"}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Convert", " ", "and", " ", "resize", " ", "the", " ", "input"}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", " ", "=", " ", 
    RowBox[{"GradientOrientationFilter", "[", 
     RowBox[{"f", ",", " ", "12", ",", 
      RowBox[{"Method", "->", "\"\<Sobel\>\""}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Apply", " ", "the", " ", "Gradient", " ", "Ori", " ", "Filter", " ", 
    "with", " ", "\"\<derivative kernel\>\"", " ", "specified", " ", "as", 
    " ", "Soble"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diminput", " ", "=", " ", 
   RowBox[{"ImageDimensions", "[", "input", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dimf", " ", "=", " ", 
   RowBox[{"ImageDimensions", "[", "f", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"range", "  ", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"dimf", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"dimf", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Build", " ", "Dimensions", " ", "for", " ", "input", " ", "image", " ", 
    "and", " ", "adjusted", " ", "miage", " ", "respectively"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gtpose", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"ImageData", "[", "g", "]"}], "]"}]}], ";"}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Revgtpose", "=", 
    RowBox[{"Reverse", "/@", "gtpose"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Arrange", " ", "&"}], " ", "Reverse", " ", "the", " ", 
    "transpose", " ", "of", " ", "the", " ", "dataset", " ", "passed", " ", 
    "frm", " ", "the", " ", "gradient", " ", "orientation", " ", "map"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lineSegment", "[", 
     RowBox[{"{", 
      RowBox[{"pos_List", ",", "theta_"}], "}"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RandomColor", "[", "]"}], ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pos", "-", 
          RowBox[{"3", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "theta", "]"}], ",", 
             RowBox[{"Sin", "[", "theta", "]"}]}], "}"}]}]}], ",", 
         RowBox[{"pos", "+", 
          RowBox[{"3", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "theta", "]"}], ",", 
             RowBox[{"Sin", "[", "theta", "]"}]}], "}"}]}]}]}], "}"}], 
       "]"}]}], "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "We", " ", "specify", " ", "the", " ", "use", " ", "of", " ", "random", 
     " ", "color", 
     RowBox[{"(", 
      RowBox[{
      "indeed", " ", "graycolor", " ", "at", " ", "last", " ", "by", " ", 
       "calling", " ", "default", " ", "function"}], ")"}], "to", " ", "draw",
      " ", "the", " ", "lines"}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "specify", " ", "the", " ", "start", " ", "and", " ", "final", 
    " ", "position", " ", "by", " ", "two", " ", "coordiantes", " ", "and", 
    " ", "generate", " ", "lines", " ", "between", " ", "them"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"strokes", "=", 
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"lineSegment", "[", 
        RowBox[{"{", 
         RowBox[{"#2", ",", "#1"}], "}"}], "]"}], "&"}], ",", "Revgtpose", 
      ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "we", " ", "map", " ", "each", " ", "element", " ", "in", " ", 
     "Revgtpose"}], ",", " ", 
    RowBox[{"the", " ", "gradient", " ", "orientation"}], ",", " ", 
    RowBox[{
    "to", " ", "the", " ", "lines", " ", "we", " ", "generate", " ", 
     "above"}], ",", " ", 
    RowBox[{"with", " ", "a", " ", "length", " ", "of", " ", "2", 
     RowBox[{"(", 
      RowBox[{
      "respectively", " ", "matches", " ", "start", " ", "point", " ", "and", 
       " ", "end", " ", "point"}]}]}]}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"graph", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"strokes", ",", 
      RowBox[{"ImageSize", "->", "diminput"}], ",", 
      RowBox[{"PlotRange", "->", "range"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"GrayLevel", "[", "0.5", "]"}]}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Graph", " ", "the", " ", "image", " ", "and", " ", "set", " ", "the", 
     " ", "background", " ", "to", " ", "standard", " ", "grey", " ", "value",
      " ", 
     RowBox[{"i", ".", "e", ".", " ", "k"}]}], " ", "=", " ", "0.5"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"output", "=", 
    RowBox[{"ColorConvert", "[", 
     RowBox[{
      RowBox[{"Image", "[", "graph", "]"}], ",", "\"\<Grayscale\>\""}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Output", " ", "the", " ", "image", " ", "with", " ", "appropriate", " ", 
    "size", " ", "and", " ", "color", " ", "distribution"}], 
   "*)"}]}], "\[IndentingNewLine]", "output"}], "Input",
